{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "pnpm --filter independum run dev",
    "format": "biome check --write && markdownlint-cli2 --fix",
    "check": "pnpm run check:biome && pnpm run check:markdown && pnpm run check:docs && pnpm run check:characters && pnpm run check:layout && pnpm run check:comments && pnpm run check:styles && pnpm run check:types && pnpm run check:unused && pnpm run check:duplicates && pnpm run test",
    "check:biome": "biome check --error-on-warnings",
    "check:markdown": "markdownlint-cli2",
    "check:docs": "node scripts/check-docs.ts",
    "check:characters": "node scripts/check-characters.ts",
    "check:layout": "node scripts/check-layout.ts",
    "check:comments": "node scripts/check-comments.ts",
    "check:styles": "node scripts/check-styles.ts",
    "check:types": "tsc --noEmit && pnpm --recursive run check:types",
    "check:unused": "knip --treat-config-hints-as-errors",
    "check:duplicates": "jscpd",
    "test": "vitest run"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "markdownlint-cli2": "^0.24.0",
    "oxc-parser": "~0.154.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
