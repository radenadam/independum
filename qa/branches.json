    {
      "clickOn": "[...document.querySelectorAll('button')].find(element => element.textContent.trim() === 'Prompt 1 of 2')"
    },
    {
      "clickOn": "[...document.querySelectorAll('[role=dialog] button')].find(element => element.textContent.includes('Edited branch prompt.'))"
    },
    {
