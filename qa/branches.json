      "shot": "edited-desktop"
    },
    {
      "clickOn": "document.querySelector('button[aria-label=\"Reply actions\"]')"
    },
    {
      "run": "({ currentSettingsVisible: document.body.innerText.includes('Uses current agent settings.') })"
    },
    {
      "clickOn": "[...document.querySelectorAll('button')].find(element => element.textContent.trim() === 'Retry')",
      "wait": 0
    },
    {
      "run": "(async () => { for (let attempt = 0; attempt < 350; attempt += 1) { if (!document.querySelector('button[aria-label=Stop]') && document.body.innerText.includes('Reply 2 of 2')) return { retriedBranch: true }; await new Promise(resolve => setTimeout(resolve, 50)); } return false; })()",
      "shot": "retried-desktop"
    },
    {
      "clickOn": "[...document.querySelectorAll('button')].find(element => element.textContent.trim() === 'Prompt 2 of 2')"
    },
    {
      "run": "({ fileBoundaryVisible: document.body.innerText.includes('Changing branches changes saved messages. Files keep their current state.') })"
    },
    {
      "clickOn": "[...document.querySelectorAll('[role=dialog] button')].find(element => element.textContent.includes(window.branchOriginalText))"
    },
    {
      "run": "({ originalRestored: document.querySelector('[data-user] p').textContent === window.branchOriginalText, originalSelected: document.body.innerText.includes('Prompt 1 of 2') })"
